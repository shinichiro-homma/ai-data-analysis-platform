{
  "name": "jupyterlab-ai-sync",
  "version": "0.1.0",
  "type": "module",
  "description": "JupyterLab extension for AI realtime sync",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "license": "MIT",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && jupyter labextension build .",
    "build:lib": "tsc",
    "build:labextension": "jupyter labextension build .",
    "watch": "tsc -w",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/nbformat": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@jupyterlab/builder": "^4.0.0"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "styleModule": "style/index.css",
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab-ai-sync/labextension",
    "schemaDir": "schema"
  }
}
